# Llave de OpenAI (solo servidor; nunca llega al navegador)
OPENAI_API_KEY=
# Modelo de voz en tiempo real
REALTIME_MODEL=gpt-realtime
# Voz del agente
REALTIME_VOICE=marin
# Llamadas permitidas por IP al día
DAILY_CALLS_PER_IP=1
# Duración máxima de una llamada (segundos)
MAX_CALL_SECONDS=300
# Cloudflare Turnstile (opcional; si está vacío no se valida)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
